      <% const menuScenes = [
        ['atelier','创作室','v2/hero',1672,941,'日光排练室里，虹夏回望鼓组的主题插画'],
        ['notes','笔记','v2/notes',1536,1024,'虹夏在窗边书桌上写笔记的主题插画'],
        ['projects','项目','v3/projects',1672,941,'虹夏在电子制作桌前创作的项目主题插画'],
        ['research','研究','v2/research',1536,1024,'虹夏抱着笔记本，在星图与暖灯之间沉思的研究室主题插画'],
        ['life','生活','v2/life',1536,1024,'雨后的下北泽街头，虹夏在暖灯与湿润街道间回望的主题插画'],
        ['about','关于','v3/about',1024,1536,'持鼓槌的虹夏舞台主题肖像插画'],
        ['lounge','后台小屋','v2/lounge',1536,1024,'虹夏在温暖后台捧着茶杯休息的主题插画'],
        ['studio','节奏实验室','v2/stage',1672,941,'虹夏在暖色舞台灯光下演奏鼓组的主题插画'],
        ['guestbook','留言','v3/guestbook',1916,821,'虹夏在暮色屋顶上，身后是城市灯火的主题插画']
