<section class="reading-page content-view"><div class="reading-nav"><a href="<%= url_for(page.series === 'hot100' ? 'series/hot100/' : 'notes/') %>" aria-label="返回笔记目录">←</a><% if (page.categories && page.categories.length) { %><a href="<%= url_for(page.categories.first().path) %>"><%= page.categories.first().name %></a><% } %></div>
  <header class="reading-opener"><span class="eyebrow"><%= page.series === 'hot100' ? 'HOT100 / ' + String(page.series_order).padStart(3,'0') : 'CC ATELIER / FIELD NOTES' %></span><img class="reading-art" src="<%= url_for(theme.nijika.stage) %>" alt="" aria-hidden="true"><h1 tabindex="-1"><%= page.title %><% if (!/[.!?。！？]$/.test(page.title || "")) { %><span>.</span><% } %></h1><div class="reading-meta"><span><%= page.author || config.author %></span><% if (page.date) { %><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY.MM.DD') %></time><% } %></div></header>
  <div class="reading-layout"><article>
  <div class="article-body markdown-body"><%- page.content %></div>
  <% if (page.tags && page.tags.length) { %><nav class="article-tags" aria-label="文章标签"><% page.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }) %></nav><% } %>
  <% if(page.source_url){ %><p class="article-source">原载于 <a href="<%= page.source_url %>" target="_blank" rel="noopener noreferrer">CSDN ↗</a><% if(page.series === 'hot100'){ %> · <a href="<%= url_for('series/hot100/') %>">Hot100 专题</a><% } %></p><% } %>
  <footer class="article-footer"><span class="article-end" aria-hidden="true"></span><a href="<%= page.source_url ? "https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans" : "https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" %>" target="_blank" rel="noopener noreferrer"><%= page.source_url ? "CC BY-SA 4.0" : "CC BY-NC-SA 4.0" %></a><a class="back-to-notes" href="<%= url_for(page.series === 'hot100' ? 'series/hot100/' : 'notes/') %>" aria-label="返回笔记目录">↖</a></footer>
  <% const ordered=page.series === 'hot100' ? nijika_series() : []; const previous=ordered.length ? ordered.find(p=>p.series_order===page.series_order-1) : page.prev; const next=ordered.length ? ordered.find(p=>p.series_order===page.series_order+1) : page.next; %>
  <% if (previous || next) { %><nav class="neighbor-posts" aria-label="相邻文章"><% if (previous) { %><a href="<%= url_for(previous.path) %>"><small>上一篇</small><span><%= previous.title %></span></a><% } if (next) { %><a href="<%= url_for(next.path) %>"><small>下一篇</small><span><%= next.title %></span></a><% } %></nav><% } %>
  </article>
  <% if (/<h[1-3]\b/i.test(page.content || '')) { %><aside class="reading-toc" aria-label="文章目录"><details open><summary>这一篇</summary><%- partial('pages/post/toc') %></details></aside><% } %>
  </div>
</section>
