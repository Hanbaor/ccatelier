<section class="reading-page content-view"><div class="reading-nav"><a href="<%= url_for('notes/') %>" aria-label="返回笔记目录">←</a><% if (page.categories && page.categories.length) { %><a href="<%= url_for(page.categories.first().path) %>"><%= page.categories.first().name %></a><% } %></div>
  <div class="reading-layout"><article><header><h1 tabindex="-1"><%= page.title %><% if (!/[.!?。！？]$/.test(page.title || "")) { %><span>.</span><% } %></h1><div class="reading-meta"><span><%= page.author || config.author %></span><% if (page.date) { %><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY.MM.DD') %></time><% } %></div></header>
  <div class="article-body markdown-body"><%- page.content %></div>
  <% if (page.tags && page.tags.length) { %><nav class="article-tags" aria-label="文章标签"><% page.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }) %></nav><% } %>
  <footer class="article-footer"><span class="article-end" aria-hidden="true"></span><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a><a class="back-to-notes" href="<%= url_for('notes/') %>" aria-label="返回笔记目录">↖</a></footer>
  <% if (page.prev || page.next) { %><nav class="neighbor-posts" aria-label="相邻文章"><% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>"><small>上一篇</small><span><%= page.prev.title %></span></a><% } if (page.next) { %><a href="<%= url_for(page.next.path) %>"><small>下一篇</small><span><%= page.next.title %></span></a><% } %></nav><% } %>
  </article>
  <% if (/<h[1-3]\b/i.test(page.content || '')) { %><aside class="reading-toc" aria-label="文章目录"><details open><summary>这一篇</summary><%- partial('pages/post/toc') %></details></aside><% } %>
  </div>
</section>
