<section class="reading-page reading-studio content-view"><div class="reading-nav"><a href="<%= url_for('notes/') %>" aria-label="返回笔记目录">← 留声档案</a><span>READING STUDIO</span><button class="queue-open">阅读队列 <span data-queue-count>0</span> ↗</button></div>
  <div class="reading-layout reader-columns">
  <aside class="reading-toc chapter-rail" aria-label="文章目录"><details open><summary>这一篇 <span>TRACKLIST</span></summary><div class="chapter-meter" aria-hidden="true"><i></i></div><%- toc(live_article_content(page),{class:'nav',list_number:true,max_depth:3}) %></details><a class="chapter-library" href="<%= url_for('notes/') %>?view=graph">✧ 回到主题星图</a></aside>
  <article class="reader-paper">
  <header class="reading-opener"><span class="eyebrow"><%= page.series === 'hot100' ? 'SIDE B / HOT100 — ' + String(page.series_order).padStart(3,'0') : 'SIDE A / FIELD NOTES' %></span><h1 tabindex="-1"><%= page.title %></h1><div class="reading-meta"><span><%= page.author || config.author %></span><% if (page.date) { %><time datetime="<%= date_xml(page.date) %>"><%= date(page.date,'YYYY.MM.DD') %></time><% } %><span><%= after_hours_minutes(page.content) %> MIN READ</span><span class="reader-spark" aria-hidden="true">✳</span></div></header>
  <%- partial('nijika/article-tools') %>
  <div class="article-body markdown-body"><%- live_article_content(page) %></div>
  <% if (page.tags && page.tags.length) { %><nav class="article-tags" aria-label="文章标签"><% page.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }) %></nav><% } %>
  <% if(page.source_url){ %><p class="article-source">原载于 <a href="<%= page.source_url %>" target="_blank" rel="noopener noreferrer">CSDN ↗</a><% if(page.series === 'hot100'){ %> · <a href="<%= url_for('series/hot100/') %>">Hot100 专题</a><% } %></p><% } %>
  <footer class="article-footer"><span class="article-end" aria-hidden="true"></span><a href="<%= page.source_url ? "https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans" : "https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" %>" target="_blank" rel="noopener noreferrer"><%= page.source_url ? "CC BY-SA 4.0" : "CC BY-NC-SA 4.0" %></a><a class="back-to-notes" href="<%= url_for(page.series === 'hot100' ? 'series/hot100/' : 'notes/') %>" aria-label="返回笔记目录">↖</a></footer>
  <% const ordered=page.series === 'hot100' ? nijika_series() : []; const previous=ordered.length ? ordered.find(p=>p.series_order===page.series_order-1) : page.prev; const next=ordered.length ? ordered.find(p=>p.series_order===page.series_order+1) : page.next; %>
  <% if (previous || next) { %><nav class="neighbor-posts" aria-label="相邻文章"><% if (previous) { %><a href="<%= url_for(previous.path) %>"><small>上一篇</small><span><%= previous.title %></span></a><% } if (next) { %><a href="<%= url_for(next.path) %>"><small>下一篇</small><span><%= next.title %></span></a><% } %></nav><% } %>
  <section class="reader-encore"><span class="eyebrow">END OF THIS TRACK</span><div><button data-queue-done>✓ 读完这一篇</button><button data-queue-add>＋ 加入队列</button></div><a data-queue-next hidden></a></section>
  <% const related=live_related(page); if(related.length){ %><section class="reader-related"><span class="eyebrow">沿着这个主题 / RELATED TRACKS</span><% related.forEach(post=>{ %><a href="<%= url_for(post.path) %>"><span><%= post.title %></span><i>↗</i></a><% }) %></section><% } %>
  <%- partial('nijika/comments') %>
  </article>
  <aside class="reader-workbench"><details open><summary>阅读工作台 <span>＋</span></summary><div class="workbench-body">
    <div class="reader-find"><label for="reader-find">文内查找</label><input id="reader-find" type="search" placeholder="在这一篇里寻找…" maxlength="120"><div><span data-find-status role="status">输入关键词</span><button data-find-prev aria-label="上一个匹配">↑</button><button data-find-next aria-label="下一个匹配">↓</button><button data-find-clear aria-label="清除文内查找">×</button></div></div>
    <div class="reader-typesetting"><span>阅读排版</span><label>字号 <input data-reader-size type="range" min="14" max="23" value="17"><output data-size-output>17</output></label><label>行距 <input data-reader-leading type="range" min="16" max="23" value="19"><output data-leading-output>1.9</output></label><label>行宽 <select data-reader-width><option value="comfortable">舒展</option><option value="narrow">紧凑</option></select></label></div>
    <div class="reader-tools-grid"><button data-notebook-open><span>✎</span>页边札记</button><button data-queue-add><span>＋</span>加入队列</button><button data-offline-save><span>⇩</span>离线保存</button><button class="offline-open"><span>▤</span>离线书架</button></div>
    <div class="reader-speech"><span>听这一篇</span><div><button data-speech-play>朗读</button><button data-speech-pause>暂停</button><button data-speech-stop>停止</button></div><label>语速<select data-speech-rate><option value="0.8">0.8×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option></select></label><p data-speech-status role="status">使用浏览器的可用语音。</p></div>
    <p class="workbench-note">选中正文，留下自己的札记。</p>
  </div></details></aside>
  </div>
</section>
