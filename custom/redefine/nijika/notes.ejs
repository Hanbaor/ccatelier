<section class="index-page content-view writing-library" aria-label="笔记目录">
<header class="library-mast"><div><span class="eyebrow">01 / THE WRITING ROOM</span><h1 tabindex="-1">纸上留声<span>.</span></h1></div><a href="<%= url_for('archives/') %>">全部归档 <span>↗</span></a></header>
<% const posts=page.posts.toArray(); const series=nijika_series(); if(posts.length){ const lead=posts[0]; %>
<article class="note-feature library-lead"><div class="feature-copy"><div class="minimal-meta"><span><%= lead.categories.length ? lead.categories.first().name : '随笔' %></span><time datetime="<%= date_xml(lead.date) %>"><%= date(lead.date,'YYYY.MM.DD') %></time></div><h2><a href="<%= url_for(lead.path) %>"><%= lead.title %></a></h2><a class="arrow-link" href="<%= url_for(lead.path) %>"><span>开始阅读</span><%- partial('nijika/arrow') %></a></div><a class="feature-image" href="<%= url_for(lead.path) %>" aria-label="阅读 <%= lead.title %>"><img src="<%= url_for(lead.cover || theme.nijika.cover) %>" alt="<%= lead.cover ? lead.title : '虹夏的夜归时刻，官方动画剧照' %>" fetchpriority="high"><span class="photo-arrow" aria-hidden="true">↗</span></a></article>
<% } %>
<% if (series.length && page.current===1) { %><a class="collection-strip" href="<%= url_for('series/hot100/') %>"><span class="collection-disc" aria-hidden="true">100</span><div><span class="eyebrow">持续更新 / ALGORITHM NOTES</span><h2>LeetCode Hot100</h2><p><%= series.length %> 道题 · 按专题收录</p></div><span class="collection-arrow" aria-hidden="true">↗</span></a><% } %>
<% if(posts.length>1){ %><div class="library-list-head"><span>继续翻阅</span><span><%= nijika_count(nijika_writing().length) %> ENTRIES</span></div><div class="post-list"><% posts.slice(1).forEach(post=>{ %><%- partial('nijika/post-row',{post}) %><% }) %></div><% } %>
<%- partial('nijika/pagination') %>
</section>
