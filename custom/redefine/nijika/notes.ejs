<% const counts=after_hours_counts(); %>
<section class="live-archive content-view" data-archive aria-label="笔记目录">
  <header class="archive-mast"><div><span class="eyebrow">THE LIVE ARCHIVE / VOL. 01</span><h1 tabindex="-1">留声档案<span>Notes.</span></h1></div><div class="archive-mast-index"><strong><%= counts.posts %><i>✳</i></strong><span>每一篇，都有回声。</span></div></header>
  <div class="archive-intro"><div class="archive-disc" aria-hidden="true"><span>CC<br>33⅓</span></div><div><span class="eyebrow">SIDE A — WORDS & IDEAS</span><p>沿着一个念头，<br>听见下一段。</p></div><a href="<%= url_for('series/hot100/') %>"><small>SIDE B / ALGORITHM</small><b>Hot100 <span>↗</span></b><span>一百道题，循序渐进。</span></a><button class="archive-graph-invite" data-graph-invite hidden><span aria-hidden="true">✦ · ✧</span><b>在星图里漫游 ↗</b><small>文章之间，藏着哪些连接？</small></button></div>
  <div class="archive-app" hidden>
    <form class="archive-search" role="search"><label for="archive-q">寻找一个频率</label><div><span aria-hidden="true">⌕</span><input id="archive-q" type="search" maxlength="200" placeholder="搜索标题、正文、主题…" autocomplete="off"><kbd>/</kbd></div><button type="reset">清空筛选 ↺</button></form>
    <div class="archive-layout">
      <aside class="archive-filters" aria-label="文章筛选"><span class="eyebrow">FILTER / 频段</span><div class="archive-group" role="group" aria-label="文章类型"><button type="button" data-group="all">全部 <span><%= counts.posts %></span></button><button type="button" data-group="writing">手记 <span><%= counts.writing %></span></button><button type="button" data-group="hot100">Hot100 <span><%= counts.series %></span></button></div><label>阅读时长<select data-duration><option value="all">任意时长</option><option value="short">5 分钟以内</option><option value="medium">6–15 分钟</option><option value="long">15 分钟以上</option></select></label><label>主题<select data-tag><option value="">所有主题</option></select></label><div class="archive-filter-tags" aria-label="热门主题"></div><button type="button" class="queue-open archive-queue-link">阅读队列 <span data-queue-count>0</span> ↗</button><a class="archive-studio-link" href="<%= url_for('studio/') %>"><span>换个节奏？</span><b>节奏实验室 ↗</b><i aria-hidden="true">▂ ▆ ▃ █ ▄</i></a></aside>
      <div class="archive-main"><div class="archive-toolbar"><span data-archive-count role="status" aria-live="polite">正在调频…</span><label class="sr-only" for="archive-sort">排序</label><select id="archive-sort"><option value="newest">最近发布</option><option value="oldest">最早发布</option><option value="minutes">阅读时长</option><option value="title">按标题</option></select><div role="group" aria-label="浏览方式"><button type="button" data-view="grid" title="唱片架" aria-label="唱片架">▦</button><button type="button" data-view="list" title="曲目表" aria-label="曲目表">☷</button><button type="button" data-view="graph" title="主题星图" aria-label="主题星图">✧</button></div></div>
      <div data-archive-results class="archive-results"></div><button data-archive-more class="archive-more" hidden>再翻一面 ↓</button>
      <section class="constellation" hidden aria-label="主题星图"><div class="constellation-top"><span><i></i> CONSTELLATION / 真实主题关联</span><div><button type="button" data-graph-zoom="in" aria-label="放大星图">+</button><button type="button" data-graph-zoom="out" aria-label="缩小星图">−</button><button type="button" data-graph-reset>复位</button></div></div><canvas tabindex="0" aria-label="可拖动的主题星图；方向键平移，加减键缩放。也可使用下方列表选择"></canvas><div class="constellation-detail"><span>选择一颗星，循着关联继续阅读。</span></div><div class="constellation-bottom"><span>拖动节点 · 拖动空白平移 · Ctrl + 滚轮缩放</span><label>直接选择<select data-graph-select><option value="">选择文章或主题</option></select></label></div></section>
      </div>
    </div>
  </div>
  <div class="archive-fallback"><p>按时间翻阅 · <a href="<%= url_for('archives/') %>">完整归档 ↗</a></p><div class="post-list"><% page.posts.each(post=>{ %><%- partial('nijika/post-row',{post}) %><% }) %></div><%- partial('nijika/pagination') %></div>
</section>
