<section class="cover cinema-v3" aria-label="虹夏主题封面" data-street="<%= url_for(theme.nijika.cover) %>" data-stage="<%= url_for(theme.nijika.stage) %>">
  <figure class="cinema-art" id="cover-photograph" aria-label="虹夏的舞台"><picture><source media="(max-width: 600px)" srcset="<%= url_for('atelier/images/v3/about-960.webp') %> 960w, <%= url_for('atelier/images/v3/about.webp') %> 1024w" sizes="100vw"><img id="cover-image" src="<%= url_for('atelier/images/v3/hero.webp') %>" srcset="<%= url_for('atelier/images/v3/hero-960.webp') %> 960w, <%= url_for('atelier/images/v3/hero.webp') %> 1916w" sizes="100vw" width="1916" height="821" alt="深蓝与琥珀追光中演奏鼓组的伊地知虹夏，精绘主题同人插画" fetchpriority="high"></picture></figure>
  <div class="cinema-copy"><h1 class="cinema-title" tabindex="-1" aria-label="CC Atelier"><span>CC<span>.</span></span><em>ATELIER</em></h1><div class="cinema-bottom"><p>代码、研究与生活。</p><a class="enter-button cinema-enter" aria-label="进入创作室" href="<%= url_for('atelier/') %>" data-enter><span>探索创作室</span><%- partial('nijika/editorial-arrow') %></a></div></div>
</section>
