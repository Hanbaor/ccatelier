<%
const homeWriting = nijika_writing().filter(post => !/^Hello CC Atelier$/i.test(post.title)).slice(0,3);
%>
<section class="cover personal-home home-edition" aria-label="CC 的个人网站">
  <header class="personal-hero">
    <figure class="personal-portrait" id="cover-photograph"><picture><source media="(max-width:600px)" srcset="<%= nijika_art_srcset('/atelier/images/v3/hero.webp') %>" sizes="(max-width:500px) calc(130vw - 52px), (max-width:760px) 119.6vw, 1916px"><img id="cover-image" src="<%= url_for('atelier/images/v3/hero.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v3/hero.webp') %>" sizes="(max-width:500px) calc(130vw - 52px), (max-width:760px) 119.6vw, 1916px" width="1916" height="821" alt="舞台追光下演奏鼓组的伊地知虹夏，本站主题同人插画" fetchpriority="high"></picture><figcaption><span>NIJIKA / ON STAGE</span><button type="button" class="livehouse-open" data-live-open hidden>进入现场 <span aria-hidden="true">↗</span></button></figcaption></figure>
    <div class="personal-intro">
      <p class="personal-kicker">CC 的个人网站 <span aria-hidden="true">/</span> NOTES &amp; EXPERIMENTS</p>
      <h1 tabindex="-1">CC<span>.</span><small>ATELIER</small></h1>
      <p class="personal-statement">记录代码、<br>研究与生活。</p>
      <nav class="personal-actions" aria-label="从这里开始"><a class="enter-button personal-primary" href="<%= url_for('notes/') %>" data-enter>阅读笔记 <%- partial('nijika/editorial-arrow') %></a><a href="<%= url_for('about/') %>">关于 CC <span aria-hidden="true">↗</span></a></nav>
    </div>
  </header>
  <div class="home-understage"><p>关注 <span>AI Agent · Database · Text-to-SQL</span></p><a href="<%= theme.nijika.github %>" target="_blank" rel="noopener noreferrer">GitHub <%- partial('nijika/editorial-arrow') %></a></div>
  <nav class="home-directory" aria-label="本页目录"><a href="#home-writing"><small>01 / READ</small><span>写下的笔记</span><span aria-hidden="true">↓</span></a><a href="#home-making"><small>02 / BUILD</small><span>动手做的实验</span><span aria-hidden="true">↓</span></a><a href="#home-afterhours"><small>03 / PLAY</small><span>代码之外</span><span aria-hidden="true">↓</span></a></nav>

  <section class="personal-writing" id="home-writing" aria-labelledby="personal-writing-title">
    <header class="personal-section-head"><div><p class="personal-kicker">01 / SELECTED WRITING</p><h2 id="personal-writing-title">从一个问题，<br>往下多想一点。</h2></div><a href="<%= url_for('notes/') %>">全部笔记 <%- partial('nijika/editorial-arrow') %></a></header>
    <div class="home-writing-grid">
      <% homeWriting.forEach((post,index)=>{ const details=typeof live_metadata==='function'?live_metadata(post):{}; %>
      <article class="personal-note <%= index === 0 ? 'home-note-feature' : 'home-note-secondary' %>">
        <% if(index === 0){ %><a class="home-note-art" href="<%= url_for(post.path) %>" aria-label="阅读：<%= post.title %>"><img src="<%= url_for('atelier/images/v2/notes.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v2/notes.webp') %>" sizes="(max-width:760px) 92vw, 52vw" width="1536" height="1024" alt="虹夏在窗边记笔记的主题插画" loading="lazy"></a><% } %>
        <div class="home-note-content"><div class="home-note-meta"><span><%= index === 0 ? '最近一篇' : '0' + (index + 1) %></span><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time></div><h3><a href="<%= url_for(post.path) %>"><%= post.title %><%- partial('nijika/editorial-arrow') %></a></h3><% if(details.excerpt){ %><p><%= details.excerpt %></p><% } %><% if(details.topics && details.topics.length){ %><div class="home-note-topics" aria-label="文章主题"><% details.topics.slice(0,3).forEach(topic=>{ %><span><%= topic %></span><% }) %></div><% } %></div>
      </article>
      <% }) %>
      <% if(!homeWriting.length){ %><p class="personal-empty">笔记正在整理中。</p><% } %>
      <a class="home-series-link" href="<%= url_for('series/hot100/') %>"><div><small>持续整理 / ALGORITHMS</small><h3>LeetCode Hot100</h3><p>逐题记录，回头复盘。</p></div><%- partial('nijika/editorial-arrow') %></a>
    </div>
    <nav class="home-reading-topics" aria-label="按主题探索笔记"><span>继续探索</span><a href="<%= url_for('notes/') %>?q=STL&amp;group=writing">C++ 容器 ↗</a><a href="<%= url_for('notes/') %>?q=算法&amp;group=writing">算法与搜索 ↗</a><a href="<%= url_for('notes/') %>?q=PyTorch&amp;group=writing">PyTorch ↗</a></nav>
  </section>

  <section class="home-making" id="home-making" aria-labelledby="home-making-title">
    <header class="personal-section-head"><div><p class="personal-kicker">02 / BUILD &amp; EXPLORE</p><h2 id="home-making-title">把想法放进代码。</h2></div><a href="<%= url_for('projects/') %>">项目与实现 <%- partial('nijika/editorial-arrow') %></a></header>
    <div class="home-making-grid">
      <article class="home-project-feature"><a class="home-project-art" href="<%= url_for('projects/') %>#project-coursework-title" aria-label="查看 EduRAG 课程实践"><img src="<%= url_for('atelier/images/v3/projects.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v3/projects.webp') %>" sizes="(max-width:760px) 92vw, 58vw" width="1672" height="941" alt="虹夏在电子制作桌前动手实验的主题插画" loading="lazy"></a><div class="home-project-description"><div><p class="personal-kicker">课程实践 / 检索问答</p><h3><a href="<%= url_for('projects/') %>#project-coursework-title">EduRAG <%- partial('nijika/editorial-arrow') %></a></h3></div><p>从课程材料出发，<br>让回答带着来源。</p></div><div class="home-project-stack"><span>Streamlit</span><span>LlamaIndex</span><span>FAISS</span><a href="https://github.com/Hanbaor/EduRAG" target="_blank" rel="noopener noreferrer">公开源码 ↗</a></div></article>
      <article class="home-research-feature"><p class="personal-kicker">RESEARCH / 教学实验</p><h3>能运行，<br>然后呢？</h3><p class="home-research-summary">Moss 没有曲目。LEFT JOIN 后，<br>两种 COUNT 都会得到 0 吗？</p><details class="home-query-preview"><summary><span>展开，看看结果</span><span aria-hidden="true">+</span></summary><div class="home-query-example" aria-label="Moss 的曲目计数结果"><div><code>COUNT(*)</code><b>1</b></div><div><code>COUNT(t.id)</code><b>0</b></div></div><p>LEFT JOIN 为 Moss 保留一行。COUNT(*) 数行，COUNT(t.id) 不计入空值。</p></details><a class="home-research-foot" href="<%= url_for('research/') %>#sql-lab-title">自己改一条 SQL，运行对照 <%- partial('nijika/editorial-arrow') %></a></article>
    </div>
  </section>

  <section class="home-afterhours" id="home-afterhours" aria-labelledby="home-afterhours-title"><div class="home-afterhours-copy"><p class="personal-kicker">03 / AFTER HOURS</p><h2 id="home-afterhours-title">换个节奏。</h2><p>编一段鼓点，<br>或者，从第一小节开始。</p><nav aria-label="音乐与日常"><a href="<%= url_for('studio/') %>">节奏实验室 <%- partial('nijika/editorial-arrow') %></a><a href="<%= url_for('studio/practice/') %>">鼓谱排练室 <%- partial('nijika/editorial-arrow') %></a></nav></div><a class="home-afterhours-art" href="<%= url_for('studio/practice/') %>" aria-label="进入鼓谱排练室"><img src="<%= url_for('atelier/images/v5/practice-room.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v5/practice-room.webp') %>" sizes="(max-width:760px) 92vw, 60vw" width="1536" height="1024" alt="虹夏主题鼓组排练室插画" loading="lazy"><span>REHEARSAL ROOM <span aria-hidden="true">↗</span></span></a></section>
  <div class="home-colophon"><span>CC ATELIER / 代码、研究与生活</span><nav aria-label="更多个人内容"><a href="<%= url_for('atelier/') %>">逛逛创作室 ↗</a><a href="<%= url_for('guestbook/') %>">留句话 ↗</a></nav></div>
</section>
