<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f5f0e6"><meta name="color-scheme" content="light dark">
  <script>try{const light=localStorage.getItem('cc-theme')!=='dark';document.documentElement.classList.toggle('dark',!light);document.documentElement.style.colorScheme=light?'light':'dark';document.querySelector('meta[name="theme-color"]').content=light?'#f5f0e6':'#101110'}catch{}</script>
  <title><%= page.nijika === 'cover' ? config.title : (page.title || nijika_list_title()) + ' · ' + config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <link rel="alternate" type="application/atom+xml" title="CC Atelier" href="<%= url_for('atom.xml') %>">
  <%- open_graph({title:page.title || config.title, description:page.description || config.description, image:theme.nijika.cover, twitter_card:'summary_large_image'}) %>
  <link rel="icon" type="image/svg+xml" href="<%= url_for('atelier/images/favicon.svg') %>">
  <% if (page.nijika === 'cover') { %><link rel="preload" as="image" media="(min-width:601px)" href="<%= url_for('atelier/images/v3/hero.webp') %>" imagesrcset="<%= nijika_art_srcset('/atelier/images/v3/hero.webp') %>" imagesizes="100vw"><link rel="preload" as="image" media="(max-width:600px)" href="<%= url_for('atelier/images/v3/about.webp') %>" imagesrcset="<%= nijika_art_srcset('/atelier/images/v3/about.webp') %>" imagesizes="100vw"><% } %>
  <link rel="preload" as="font" href="<%= url_for('atelier/fonts/barlow-condensed-600.ttf') %>" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="<%= url_for('atelier/css/fonts.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/redefine.css') %>">
  <% if (page.content && page.content.trim()) { %><link rel="stylesheet" href="<%= url_for('css/build/tailwind.css') %>"><% } %>
  <% if (/\bfa-(solid|regular|brands)/.test(page.content || '')) { %>
  <link rel="stylesheet" href="<%= url_for('fontawesome/fontawesome.min.css') %>"><link rel="stylesheet" href="<%= url_for('fontawesome/solid.min.css') %>"><link rel="stylesheet" href="<%= url_for('fontawesome/regular.min.css') %>"><link rel="stylesheet" href="<%= url_for('fontawesome/brands.min.css') %>">
  <% } %>
  <link rel="stylesheet" href="<%= url_for('atelier/css/atelier.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/content.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/effects.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/stage.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/backstage.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/after-hours.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/archive.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/reader.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/studio.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/stage-engine.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/live-art.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/daylight.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/refinement.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/editorial.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/rooms-v2.css') %>">
  <link rel="stylesheet" href="<%= url_for('atelier/css/immersive.css') %>">
  <% if (page.nijika === 'admin') { %><meta name="robots" content="noindex,nofollow"><% } %>
  <%- export_config() %>
</head>
