<% const details=live_metadata(post); %>
<article class="archive-record"><h2><a href="<%= url_for(post.path) %>"><%= post.title || '未命名文章' %></a></h2><p><%= details.excerpt %></p><div class="record-context"><% details.topics.slice(0,2).forEach(topic=>{ %><span><%= topic %></span><% }); %></div><div class="record-bottom"><span><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time></span></div></article>
