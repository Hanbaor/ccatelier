<% const details=live_metadata(post); %>
<article class="archive-record"><div class="record-top"><b><%= nijika_count(index+1) %></b></div><h2><a href="<%= url_for(post.path) %>"><%= post.title || '未命名文章' %></a></h2><p><%= details.excerpt %></p><div class="record-context"><span><%= details.kind==='technical'?'技术笔记':'手记' %></span><% details.topics.slice(0,3).forEach(topic=>{ %><span><%= topic %></span><% }); %></div><div class="record-bottom"><span><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time></span></div></article>
