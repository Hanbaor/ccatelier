<% const writing=nijika_writing(); const latest=writing[0]; %>
<section class="hub-v3" aria-label="创作室">
  <header class="hub-heading"><h1 tabindex="-1">创作室</h1><a href="<%= url_for('notes/') %>">全部笔记 <%- partial('nijika/editorial-arrow') %></a></header>
  <nav class="hub-grid" aria-label="栏目">
    <a class="hub-card hub-writing" data-reveal href="<%= url_for('notes/') %>"><img src="<%= url_for(theme.nijika.reading_art) %>" srcset="<%= nijika_art_srcset(theme.nijika.reading_art) %>" sizes="(max-width:600px) 92vw, 58vw" width="1536" height="1024" alt="虹夏在日光窗边写笔记的主题插画" fetchpriority="high"><div class="hub-card-caption"><h2>笔记</h2><% if(latest){ %><p><%= latest.title %></p><% } %><%- partial('nijika/editorial-arrow') %></div></a>
    <a class="hub-card hub-projects" data-reveal href="<%= url_for('projects/') %>"><img src="<%= url_for('atelier/images/v3/projects.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v3/projects.webp') %>" sizes="(max-width:600px) 92vw, 38vw" width="1672" height="941" alt="虹夏的音乐电子创作工作台，主题同人插画" fetchpriority="high"><div class="hub-card-caption"><h2>项目</h2><p>CC Atelier</p><%- partial('nijika/editorial-arrow') %></div></a>
    <a class="hub-card hub-research" data-reveal href="<%= url_for('research/') %>"><img src="<%= url_for('atelier/images/v2/research.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v2/research.webp') %>" sizes="(max-width:600px) 92vw, 55vw" width="1536" height="1024" alt="虹夏与研究手稿、星图的主题插画" loading="lazy"><div class="hub-card-caption"><h2>研究</h2><p>Database / Text-to-SQL</p><%- partial('nijika/editorial-arrow') %></div></a>
    <a class="hub-card hub-life" data-reveal href="<%= url_for('life/') %>"><img src="<%= url_for('atelier/images/v2/life.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v2/life.webp') %>" sizes="(max-width:600px) 92vw, 40vw" width="1536" height="1024" alt="雨后下北泽的虹夏与街景，主题同人插画" loading="lazy"><div class="hub-card-caption"><h2>生活</h2><%- partial('nijika/editorial-arrow') %></div></a>
    <a class="hub-about" href="<%= url_for('about/') %>"><span>关于 CC</span><%- partial('nijika/editorial-arrow') %></a>
  </nav>
  <section class="hub-recent" aria-labelledby="hub-recent-title"><h2 id="hub-recent-title">最近笔记</h2><% writing.slice(0,3).forEach(post=>{ %><a href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time><h3><%= post.title %></h3><%- partial('nijika/editorial-arrow') %></a><% }) %></section>
</section>
