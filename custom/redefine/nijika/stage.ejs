<% const writing=nijika_writing(); const lead=writing[0]; const leadDetails=lead&&typeof live_metadata==='function'?live_metadata(lead):{}; %>
<section class="personal-atelier" aria-label="创作室">
  <header class="atelier-personal-heading"><div><p class="personal-kicker">CC ATELIER</p><h1 tabindex="-1">CC 的创作室</h1></div><a href="<%= url_for('about/') %>">关于 CC <%- partial('nijika/editorial-arrow') %></a></header>
  <section class="atelier-writing-feature" aria-labelledby="atelier-writing-title">
    <div class="atelier-writing-copy"><p class="personal-kicker">WRITING / 最近更新</p><% if(lead){ %><h2 id="atelier-writing-title"><a href="<%= url_for(lead.path) %>"><%= lead.title %></a></h2><% if(leadDetails.excerpt){ %><p class="atelier-writing-summary"><%= leadDetails.excerpt %></p><% } %><time datetime="<%= date_xml(lead.date) %>"><%= date(lead.date,'YYYY.MM.DD') %></time><a class="atelier-read" href="<%= url_for(lead.path) %>">阅读这篇 <%- partial('nijika/editorial-arrow') %></a><% }else{ %><h2 id="atelier-writing-title">笔记</h2><p>笔记正在整理中。</p><% } %></div>
    <figure class="atelier-reading-art"><img src="<%= url_for(theme.nijika.reading_art) %>" srcset="<%= nijika_art_srcset(theme.nijika.reading_art) %>" sizes="(max-width:760px) 92vw, 47vw" width="1536" height="1024" alt="日光窗边写笔记的虹夏主题插画" fetchpriority="high"></figure>
  </section>
  <section class="atelier-writing-index" aria-labelledby="atelier-index-title"><header class="personal-section-head"><h2 id="atelier-index-title">笔记</h2><a href="<%= url_for('notes/') %>">全部笔记 <%- partial('nijika/editorial-arrow') %></a></header><div class="personal-note-list"><% writing.slice(1,4).forEach(post=>{ %><article class="personal-note"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time><div><h3><a href="<%= url_for(post.path) %>"><%= post.title %><%- partial('nijika/editorial-arrow') %></a></h3></div></article><% }) %></div></section>
  <section class="atelier-work-pair" aria-label="项目与研究"><a class="atelier-work-feature" href="<%= url_for('projects/') %>"><img src="<%= url_for('atelier/images/v3/projects.webp') %>" srcset="<%= nijika_art_srcset('/atelier/images/v3/projects.webp') %>" sizes="(max-width:760px) 92vw, 54vw" width="1672" height="941" alt="虹夏的电子创作工作台主题插画" loading="lazy"><div><p class="personal-kicker">PROJECT</p><h2>CC Atelier</h2><%- partial('nijika/editorial-arrow') %></div></a><a class="atelier-research-link" href="<%= url_for('research/') %>"><p class="personal-kicker">RESEARCH</p><h2>研究</h2><p>Database<br>Text-to-SQL</p><span>打开研究室 <%- partial('nijika/editorial-arrow') %></span></a></section>
  <section class="atelier-interests" aria-labelledby="atelier-interests-title"><header class="personal-section-head"><div><p class="personal-kicker">AFTER HOURS</p><h2 id="atelier-interests-title">音乐与生活</h2></div></header><div class="atelier-interest-layout"><a class="atelier-music-image" href="<%= url_for('studio/') %>" aria-label="节奏实验室"><img src="<%= url_for('atelier/images/v5/practice-room.webp') %>" srcset="<%= url_for('atelier/images/v5/practice-room-960.webp') %> 960w, <%= url_for('atelier/images/v5/practice-room.webp') %> 1536w" sizes="(max-width:760px) 92vw, 46vw" width="1536" height="1024" alt="虹夏在日光排练室里练习深蓝鼓组的主题插画" loading="lazy"></a><nav aria-label="音乐与生活"><a href="<%= url_for('studio/') %>">节奏实验室 <%- partial('nijika/editorial-arrow') %></a><a href="<%= url_for('studio/practice/') %>">鼓谱排练室 <%- partial('nijika/editorial-arrow') %></a><a href="<%= url_for('life/') %>">生活 <%- partial('nijika/editorial-arrow') %></a></nav></div></section>
</section>
