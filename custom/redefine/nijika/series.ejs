<section class="content-view series-page" aria-label="Hot100 专题"><header class="series-header"><span class="eyebrow">THE ALGORITHM COLLECTION</span><h1 tabindex="-1">Hot<span>100</span><i>.</i></h1><p>一道一道，慢慢来。</p><a href="<%= url_for('notes/') %>">← 返回笔记</a><div class="series-serial" aria-hidden="true">VOL. 01</div></header>
<% const groups = new Map(); for (const post of page.seriesPosts) { const topic=post.topic || '其他'; if(!groups.has(topic))groups.set(topic,[]); groups.get(topic).push(post); } %>
<% if(page.introHtml){ %><details class="series-intro"><summary>关于这份题单与更新进度</summary><div class="article-body markdown-body"><%- page.introHtml %></div></details><% } %>
<div class="series-layout"><nav class="series-topics" aria-label="题目专题"><span class="eyebrow">按专题跳转</span><% let topicIndex=0;for(const [topic,posts] of groups){topicIndex++; %><a href="#topic-<%= String(topicIndex).padStart(2,'0') %>"><span><%= topic %></span><small><%= nijika_count(posts.length) %></small></a><% } %></nav><div class="series-tracks"><% topicIndex=0; for(const [topic,posts] of groups){topicIndex++; %><section id="topic-<%= String(topicIndex).padStart(2,'0') %>" class="series-group"><h2><span><%= nijika_count(topicIndex) %></span><%= topic %></h2><% for(const post of posts){ %><a class="series-track" href="<%= url_for(post.path) %>"><span class="track-number"><%= String(post.series_order).padStart(3,'0') %></span><strong><%= post.title %></strong><small><%= post.difficulty || '' %></small><span aria-hidden="true">↗</span></a><% } %></section><% } %></div></div></section>
