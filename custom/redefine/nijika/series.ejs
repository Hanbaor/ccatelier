<% const catalog=live_catalog_counts(); %>
<section class="content-view series-page" aria-label="Hot100 专题"><header class="series-header"><div class="series-topline"><span class="eyebrow">THE ALGORITHM COLLECTION</span><a href="<%= url_for('notes/') %>">← 返回笔记</a></div><h1 tabindex="-1">Hot<span>100</span><i>.</i></h1><p><%= page.seriesPosts.length %> 道题 · <%= catalog.withCode %> 题已有代码 · <%= catalog.analysisPending %> 题解析待补</p><p class="series-status-note">按原题单顺序整理；已有代码尚未做正确性校验。</p></header>
<% const groups = new Map(); for (const post of page.seriesPosts) { const topic=post.topic || '其他'; if(!groups.has(topic))groups.set(topic,[]); groups.get(topic).push(post); } %>
<% if(page.introHtml){ %><details class="series-intro"><summary>原题单说明与导入时的更新记录</summary><div class="article-body markdown-body"><%- page.introHtml %></div></details><% } %>
<details class="series-topic-disclosure"><summary>按专题跳转 <span><%= groups.size %> 个专题</span></summary><nav class="series-mobile-topics" aria-label="题目专题"><% let mobileTopicIndex=0; for(const [topic,posts] of groups){mobileTopicIndex++; %><a href="#topic-<%= String(mobileTopicIndex).padStart(2,'0') %>"><span><%= topic %></span><small><%= nijika_count(posts.length) %></small></a><% } %></nav></details>
<div class="series-layout"><nav class="series-topics" aria-label="题目专题"><span class="eyebrow">按专题跳转</span><% let topicIndex=0;for(const [topic,posts] of groups){topicIndex++; %><a href="#topic-<%= String(topicIndex).padStart(2,'0') %>"><span><%= topic %></span><small><%= nijika_count(posts.length) %></small></a><% } %></nav><div class="series-tracks"><% topicIndex=0; for(const [topic,posts] of groups){topicIndex++; %><section id="topic-<%= String(topicIndex).padStart(2,'0') %>" class="series-group"><h2><span><%= nijika_count(topicIndex) %></span><%= topic %></h2><% for(const post of posts){ const state=live_metadata(post).exercise; %><a class="series-track" href="<%= url_for(post.path) %>"><span class="track-number"><%= String(post.series_order).padStart(3,'0') %></span><span class="series-track-copy"><strong><%= post.title %></strong><span class="series-track-state"><span><%= state.hasCode?'已有代码':'题面' %></span><% if(!state.hasAnalysis){ %><span>解析待补</span><% } %></span></span><small><%= post.difficulty || '' %></small><%- partial('nijika/editorial-arrow') %></a><% } %></section><% } %></div></div></section>
