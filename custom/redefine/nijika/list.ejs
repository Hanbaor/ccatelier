<section class="content-view archive-page"><div class="feature-caption"><h1 tabindex="-1"><%= nijika_list_title() %><span><%= nijika_count(page.posts.length) %></span></h1><a class="archive-link" href="<%= url_for('notes/') %>">笔记 ↗</a></div><nav class="taxonomy-nav" aria-label="浏览文章"><a href="<%= url_for('archives/') %>">时间</a><a href="<%= url_for('categories/') %>">分类</a><a href="<%= url_for('tags/') %>">标签</a></nav><div class="post-list"><% page.posts.each(post => { %><%- partial('nijika/post-row',{post}) %><% }) %></div><%- partial('nijika/pagination') %></section>
