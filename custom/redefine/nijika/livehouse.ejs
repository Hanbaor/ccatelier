<dialog class="livehouse" id="livehouse-dialog" aria-labelledby="livehouse-title" aria-describedby="livehouse-help">
 <div class="livehouse-room">
  <picture class="livehouse-art" aria-hidden="true"><source media="(max-width:600px)" data-srcset="<%= url_for('atelier/images/v3/about-960.webp') %>"><img data-src="<%= url_for('atelier/images/v3/hero.webp') %>" alt="" width="1916" height="821"></picture>
  <canvas class="livehouse-light" data-live-canvas aria-hidden="true"></canvas>
  <div class="livehouse-shade" aria-hidden="true"></div>
  <header class="livehouse-header"><span>CC <i>/</i> LIVE HOUSE</span><button type="button" data-live-close aria-label="退出现场"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></header>
  <div class="livehouse-title"><p data-live-scene>舞台交给你</p><h2 id="livehouse-title">MAKE<br>IT <em>LIVE.</em></h2></div>
  <div class="livehouse-kit" role="group" aria-label="互动鼓组"><% for (const [key,type,label] of [['A','kick','底鼓'],['S','snare','军鼓'],['D','hat','踩镲'],['F','tom','通鼓']]) { %><button type="button" class="live-pad live-pad-<%= type %>" data-live-pad="<%= type %>" aria-label="敲击<%= label %>，快捷键 <%= key %>"><span class="live-pad-skin" aria-hidden="true"></span><span class="live-pad-label"><kbd><%= key %></kbd><span><%= label %></span></span></button><% } %></div>
  <div class="livehouse-floor" aria-hidden="true"></div>
  <div class="livehouse-deck">
   <div class="livehouse-transport"><button type="button" class="live-show" data-live-show aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg><span>开始演出</span></button><button type="button" data-live-sound aria-pressed="false" class="live-sound"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4ZM16 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg><span>开启声音</span></button><label class="live-volume">音量<input data-live-volume type="range" min="0" max="60" value="30" aria-label="现场音量"></label><button type="button" data-live-motion aria-pressed="true" class="live-motion">动态灯光</button></div>
   <details class="live-recorder" data-live-recorder>
    <summary><span class="live-record-dot" aria-hidden="true"></span>录下灵感 <span>TAKE / 01</span></summary>
    <div class="live-record-controls"><label>速度<input type="number" min="40" max="220" step="1" value="112" data-live-record-bpm aria-label="录音速度 BPM"> BPM</label><label>长度<select data-live-record-bars aria-label="录音小节数"><option value="2">2 小节</option><option value="4">4 小节</option></select></label><button type="button" data-live-record aria-pressed="false">开始录制</button><output data-live-record-position aria-live="off">准备</output></div>
    <div class="live-record-strip" data-live-record-strip aria-hidden="true"></div>
    <div class="live-record-review"><button type="button" data-live-replay aria-pressed="false" disabled>回放</button><button type="button" data-live-send data-practice-url="<%= url_for('studio/practice/') %>" disabled>送去排练 ↗</button><button type="button" data-live-record-export disabled>下载 JSON</button><span>4 拍预备 · 1/16 量化 · 本机保存</span></div>
    <p data-live-record-status role="status">只记录你敲出的节奏，不使用麦克风。</p>
   </details>
   <div class="livehouse-timeline" role="progressbar" aria-label="演出进度" aria-valuemin="0" aria-valuemax="64" aria-valuenow="0"><i data-live-progress></i><span></span><span></span><span></span><span></span></div>
   <div class="livehouse-foot"><p id="livehouse-help">触摸鼓面，或按 A S D F。声音由你开启。</p><p data-live-status role="status" aria-live="polite">静音待场</p><a href="<%= url_for('studio/practice/') %>">跟谱排练 <%- partial('nijika/editorial-arrow') %></a></div>
  </div>
  <div class="livehouse-curtain livehouse-curtain-left" aria-hidden="true"></div><div class="livehouse-curtain livehouse-curtain-right" aria-hidden="true"></div>
 </div>
</dialog>
