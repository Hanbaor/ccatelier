<section class="atelier-room room-lounge" data-lounge aria-label="后台小屋">
  <noscript><p class="community-empty">互动功能需要 JavaScript。</p></noscript>
  <header class="room-scene lounge-scene" data-reveal><img src="<%= url_for('atelier/images/v2/lounge.webp') %>" srcset="<%= url_for('atelier/images/v2/lounge-960.webp') %> 960w, <%= url_for('atelier/images/v2/lounge.webp') %> 1536w" sizes="94vw" alt="虹夏在温暖后台捧着茶杯休息的主题插画" width="1536" height="1024" fetchpriority="high"><h1 tabindex="-1">后台小屋</h1><nav class="lounge-tabs" aria-label="后台小屋区域"><a href="#reading-shelf">阅读</a><a href="#ticket-desk">票根</a><a href="#sound-desk">节奏</a></nav></header>
  <div class="lounge-grid">
    <section class="lounge-card discovery-card" id="reading-shelf"><h2>随机阅读</h2><div class="shuffle-disc" aria-hidden="true"><span>cc.</span></div><div class="shuffle-actions"><button data-random-post="writing">随机手记 <span>↗</span></button><button data-random-post="hot100">随机 Hot100 <span>↗</span></button></div></section>
    <section class="lounge-card collection-card"><div class="collection-title"><h2>阅读歌单</h2><span data-saved-count>00</span></div><div class="reading-list-tabs" role="group" aria-label="选择阅读列表"><button data-reading-list-tab="saved" aria-pressed="true">已收藏</button><button data-reading-list-tab="recent" aria-pressed="false">最近读过</button></div><div data-reading-list><p class="community-empty">还没有收藏。</p></div><span class="lounge-fine-print">仅保存在这台浏览器。</span></section>
    <section class="lounge-card passport-card" id="ticket-desk"><h2>到访票根</h2><div class="visitor-pass"><div><strong>入场券<span>✦</span></strong></div><span class="visitor-pass-id" data-pass-id>—</span><div class="passport-stamps" aria-label="你的到访印章"><% for(const [key,label] of [['atelier','入场'],['notes','听读'],['about','相识'],['guestbook','回声'],['lounge','安可']]) { %><span data-pass-stamp="<%= key %>"><i aria-hidden="true">✦</i><%= label %></span><% } %></div><span class="visitor-pass-date" data-pass-date></span></div><button class="after-text-button" data-download-ticket>下载票根 ↓</button><span class="lounge-fine-print">印章仅保存在本机。</span></section>
    <section class="lounge-card encore-note-card"><h2>每日小签</h2><div class="daily-note"><span data-daily-date></span><strong data-daily-note>给今天，留一点热爱。</strong></div><button class="after-text-button" data-copy-note>复制</button></section>
    <section class="lounge-card sound-card" id="sound-desk"><h2>节奏台</h2><a class="pixel-stage-card" href="<%= url_for('studio/') %>" aria-label="打开节奏实验室"><img src="<%= url_for(theme.nijika.pixel_art) %>" srcset="<%= nijika_art_srcset(theme.nijika.pixel_art) %>" sizes="(max-width:380px) calc(100vw - 54px), (max-width:500px) calc(100vw - 58px), (max-width:760px) calc(92vw - 18px), (max-width:1100px) calc(46vw - 62px), min(531px, calc(46vw - 69px))" alt="虹夏在舞台上演奏鼓组的主题插画" width="1672" height="941" loading="lazy"><span class="pixel-stage-bottom">节奏实验室 <b>↗</b></span></a><button class="after-solid-button rhythm-open">打开鼓机 <span>↗</span></button><span class="lounge-fine-print">点击后发声，关闭即停止。</span></section>
    <section class="lounge-card focus-card"><h2>专注计时</h2><div class="focus-amp"><div class="focus-duration" role="group" aria-label="选择专注时长"><button data-focus-minutes="25" aria-pressed="true">25 分钟</button><button data-focus-minutes="5" aria-pressed="false">5 分钟休息</button></div><output data-focus-time aria-label="剩余时间" aria-live="off">25:00</output><div class="focus-buttons"><button data-focus-start>开始</button><button data-focus-reset>重置</button></div><p data-focus-status role="status">未开始</p></div><span class="lounge-fine-print">本机保存 · 到时不响铃</span></section>
    <section class="lounge-card light-card"><h2>灯光</h2><div class="light-presets" role="group" aria-label="舞台灯光"><button data-stage-light="amber" aria-pressed="true"><i></i>暖金</button><button data-stage-light="rose" aria-pressed="false"><i></i>暮红</button><button data-stage-light="moon" aria-pressed="false"><i></i>月蓝</button></div><div class="charm-desk"><button class="triangle-charm" data-charm aria-label="碰一下虹夏的小三角挂件"><span></span></button><p data-charm-note role="status">点一下小三角</p></div></section>
    <section class="lounge-card audience-card"><h2>来访</h2><div class="audience-numbers"><div><strong data-stat="visitors">—</strong><span>来访浏览器</span></div><div><strong data-stat="views">—</strong><span>页面到访</span></div></div><small data-stats-context>正在加载……</small><div class="after-links"><button data-help-open>快捷键 ?</button></div></section>
  </div>
</section>
