<section class="content-view archive-page"><div class="feature-caption"><h1 tabindex="-1">标签<span><%= nijika_count(site.tags.length) %></span></h1></div><nav class="taxonomy-nav" aria-label="浏览文章"><a href="<%= url_for('archives/') %>">时间</a><a href="<%= url_for('categories/') %>">分类</a><a href="<%= url_for('tags/') %>" aria-current="page">标签</a></nav><div class="tag-cloud"><% site.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"><span># <%= tag.name %></span><small><%= nijika_count(tag.length) %></small></a><% }) %></div><% if (!site.tags.length) { %><p class="empty-hint">文章标签将在这里出现。</p><% } %></section>
