<section class="content-view archive-page">
  <header class="archive-heading"><div><h1 tabindex="-1">标签</h1><p class="archive-count"><%= site.tags.length %> 个标签</p></div><a class="archive-return" href="<%= url_for('notes/') %>">返回笔记</a></header>
  <nav class="taxonomy-nav" aria-label="浏览文章"><a href="<%= url_for('archives/') %>">时间</a><a href="<%= url_for('categories/') %>">分类</a><a href="<%= url_for('tags/') %>" aria-current="page">标签</a></nav>
  <div class="tag-cloud"><% site.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"><span><%= tag.name %></span><small><%= tag.length %> 篇</small></a><% }) %></div>
  <% if (!site.tags.length) { %><p class="empty-hint">文章标签将在这里出现。</p><% } %>
</section>
