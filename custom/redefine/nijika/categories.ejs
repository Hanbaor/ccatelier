<section class="content-view archive-page">
  <header class="archive-heading"><div><h1 tabindex="-1">分类</h1><p class="archive-count"><%= site.categories.length %> 个分类</p></div><a class="archive-return" href="<%= url_for('notes/') %>">返回笔记</a></header>
  <nav class="taxonomy-nav" aria-label="浏览文章"><a href="<%= url_for('archives/') %>">时间</a><a href="<%= url_for('categories/') %>" aria-current="page">分类</a><a href="<%= url_for('tags/') %>">标签</a></nav>
  <div class="taxonomy-list"><% site.categories.each(category => { %><a href="<%= url_for(category.path) %>"><span><%= category.name %></span><small><%= category.length %> 篇</small></a><% }) %></div>
  <% if (!site.categories.length) { %><p class="empty-hint">文章分类将在这里出现。</p><% } %>
</section>
