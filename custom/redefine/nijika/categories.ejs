<section class="content-view archive-page"><div class="feature-caption"><h1 tabindex="-1">分类<span><%= nijika_count(site.categories.length) %></span></h1></div><nav class="taxonomy-nav" aria-label="浏览文章"><a href="<%= url_for('archives/') %>">时间</a><a href="<%= url_for('categories/') %>" aria-current="page">分类</a><a href="<%= url_for('tags/') %>">标签</a></nav><div class="taxonomy-list"><% site.categories.each(category => { %><a href="<%= url_for(category.path) %>"><span><%= category.name %></span><small><%= nijika_count(category.length) %></small><i aria-hidden="true">↗</i></a><% }) %></div><% if (!site.categories.length) { %><p class="empty-hint">文章分类将在这里出现。</p><% } %></section>
