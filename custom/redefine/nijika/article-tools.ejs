<div class="article-toolbox" data-article-tools data-title="<%= page.title %>">
  <div class="reading-switches">
    <button data-focus-reading aria-pressed="false">专注阅读</button>
    <button type="button" data-reader-size-cycle aria-label="调整阅读字号">字号 <span>18</span></button>
    <button data-bookmark aria-pressed="false">收藏</button>
    <button data-applause aria-pressed="false">赞 <span data-applause-count>—</span></button>
    <button data-copy-link>复制链接</button>
    <button class="reading-resume" data-reading-resume hidden>继续上次阅读</button>
  </div>
  <p data-article-tool-status role="status"></p>
</div>
