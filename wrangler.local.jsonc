{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ccatelier-local-preview",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-21",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{
    "binding":"DB",
    "database_name":"ccatelier-community-local",
    // Local emulation only. Never use this identifier for a production database.
    "database_id":"00000000-0000-0000-0000-000000000001",
    "migrations_dir":"worker/migrations"
  }],
  "vars": {"LOCAL_PREVIEW":"true"}
}
