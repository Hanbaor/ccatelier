{
  "name": "ccatelier",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ccatelier-community",
    "migrations_dir": "worker/migrations"
  }],
  "triggers": {"crons": ["0 * * * *"]}
}
